# ---------------------------------------------------------------------------
# ResumeForge environment configuration
# Copy to `.env` and adjust. Every value below has a safe local default so the
# application boots without any paid third-party service.
# ---------------------------------------------------------------------------

# --- Frontend ---------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:5173

# --- Core backend -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=ResumeForge
SITE_URL=http://localhost:5173

# --- Database ---------------------------------------------------------------
# Postgres in docker-compose. For a throwaway local run you may use:
#   DATABASE_URL=sqlite+pysqlite:///./resumeforge.db
DATABASE_URL=postgresql+psycopg://resumeforge:resumeforge@localhost:5432/resumeforge
POSTGRES_USER=resumeforge
POSTGRES_PASSWORD=resumeforge
POSTGRES_DB=resumeforge

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# --- AI provider (optional) -------------------------------------------------
# Leave AI_API_KEY blank to use the deterministic rule-based provider.
AI_PROVIDER=auto
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Email (optional) -------------------------------------------------------
# Leave EMAIL_PROVIDER=console to print verification/reset links to the logs.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@resumeforge.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# --- Payments (optional) ----------------------------------------------------
# noop | stripe | razorpay
PAYMENT_PROVIDER=noop
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID_PRO_MONTHLY=
RAZORPAY_WEBHOOK_SECRET=

# --- Storage ----------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=./storage
STORAGE_BUCKET=

# --- Uploads / limits -------------------------------------------------------
MAX_UPLOAD_SIZE_MB=8

# --- Export -----------------------------------------------------------------
# Chromium-based PDF rendering. If Playwright is unavailable the API returns a
# structured error and the frontend falls back to browser printing.
PDF_ENGINE=playwright

# --- Bootstrap admin (seed script) -----------------------------------------
ADMIN_EMAIL=admin@resumeforge.local
ADMIN_PASSWORD=ChangeMe123!
